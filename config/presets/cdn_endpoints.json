{
  "description": "Шаблоны конфигураций для пробития белых списков через VK Cloud CDN и Yandex Cloud CDN",
  "providers": {
    "vk_cdn": {
      "display_name": "VK Cloud CDN",
      "recommended_transport": "xhttp",
      "fallback_transport": "ws",
      "origin_protocol": "https",
      "origin_port": 443,
      "required_headers": {
        "Host": "${BASE_DOMAIN}"
      },
      "cache_policy": {
        "enabled": false,
        "ttl_seconds": 0,
        "ignore_query_string": false,
        "gzip_compression": false
      },
      "allowed_methods": ["GET", "POST", "HEAD", "OPTIONS"],
      "nginx_proxy_settings": {
        "proxy_buffering": "off",
        "proxy_request_buffering": "off",
        "proxy_http_version": "1.1",
        "client_max_body_size": "0"
      },
      "sample_edge_domains": [
        "cdn.vk.com",
        "hb.vkcs.cloud"
      ]
    },
    "yandex_cdn": {
      "display_name": "Yandex Cloud CDN",
      "recommended_transport": "xhttp",
      "fallback_transport": "ws",
      "origin_protocol": "https",
      "origin_port": 443,
      "required_headers": {
        "Host": "${BASE_DOMAIN}"
      },
      "cache_policy": {
        "enabled": false,
        "ttl_seconds": 0,
        "ignore_cookie": true,
        "gzip_compression": false
      },
      "allowed_methods": ["GET", "POST", "PUT", "HEAD", "OPTIONS"],
      "nginx_proxy_settings": {
        "proxy_buffering": "off",
        "proxy_request_buffering": "off",
        "proxy_http_version": "1.1",
        "client_max_body_size": "0"
      },
      "sample_edge_domains": [
        "yastatic.net",
        "storage.yandexcloud.net"
      ]
    }
  }
}
