# ==============================================================================
# Server-Combain — Шаблон конфигурации по умолчанию (default.env.example)
# При установке копируется в /etc/server-combain/state.env и заполняется
# сгенерированными/введенными значениями.
# ==============================================================================

# --- Доменная модель (минимум следов в Certificate Transparency) ---
# Режим: "split" (BASE_DOMAIN + dns.BASE_DOMAIN) или "single" (всё на BASE_DOMAIN) или "wildcard"
DOMAIN_MODE="split"
BASE_DOMAIN=""
DNS_DOMAIN=""
CERT_EMAIL=""
# Метод получения SSL: "standalone_http" | "nginx_webroot" | "dns_cloudflare" | "dns_manual_wildcard"
SSL_METHOD="nginx_webroot"

# --- Сетевые параметры сервера ---
SERVER_IP=""
OLD_SERVER_IP=""
DISABLE_ICMP_PING="true"

# --- Версии компонентов (динамическое определение, без хардкода) ---
# Значение "latest" означает автоматический запрос актуального стабильного релиза
# через GitHub API / официальные репозитории при установке и обновлении.
AGH_VERSION="latest"
XUI_VERSION="latest"
XRAY_VERSION="latest"
AWG_VERSION="latest"
MTG_IMAGE="nineseconds/mtg:2"
SOCKS5_IMAGE="serjs/go-socks5-proxy:latest"
NGINX_IMAGE="nginx:alpine"

# --- Внутренние порты сервисов (закрыты на 127.0.0.1) ---
NGINX_INTERNAL_HTTPS_PORT="8443"
AGH_INTERNAL_HTTPS_PORT="8444"
AGH_HTTP_ADMIN_PORT="3000"
XUI_INTERNAL_PORT=""              # Генерируется случайно (напр. 20530-29999)
XRAY_REALITY_INTERNAL_PORT="20443"
XRAY_VK_XHTTP_PORT="20444"
XRAY_VK_WS_PORT="20445"
XRAY_YA_XHTTP_PORT="20446"
XRAY_YA_WS_PORT="20447"
BACKUP_DROP_INTERNAL_PORT="20999"

# --- Внешние порты сервисов ---
SNIPROXY_PORT="443"
NGINX_HTTP_PORT="80"
AGH_DOT_PORT="853"
AGH_CUSTOM_DOT_PORT=""            # Нестандартный порт DoT/DoQ (генерируется случайно, напр. 8853-9853)
XRAY_DIRECT_TLS_PORT="0"          # 0 = скрыт (максимальная маскировка, снаружи только 443/tcp); задайте порт (напр. 2053) при необходимости
XRAY_DIRECT_REALITY_PORT="0"      # 0 = скрыт (максимальная маскировка, снаружи только 443/tcp); задайте порт (напр. 2083) при необходимости
AWG_PORT=""                       # Нестандартный UDP-порт AmneziaWG (генерируется случайно, 30000-55000)
MTPROTO_PORT=""                   # Нестандартный TCP-порт MTProto (генерируется случайно)
SOCKS5_PORT=""                    # Нестандартный TCP-порт SOCKS5 (генерируется случайно)

# --- Секретные URL-пути за Nginx ---
SECRET_PANEL_PATH=""              # Секретный путь панели 3x-ui (без начального слеша)
XHTTP_VK_PATH=""                  # Секретный путь XHTTP для VK Cloud CDN
WS_VK_PATH=""                     # Секретный путь WebSocket для VK Cloud CDN
XHTTP_YA_PATH=""                  # Секретный путь XHTTP для Yandex Cloud CDN
WS_YA_PATH=""                     # Секретный путь WebSocket для Yandex Cloud CDN
BACKUP_DROP_PATH=""               # Временный путь Drag&Drop портала миграции (активен 1 час)
SUB_TOKEN=""                      # Секретный токен единой подписки (/sub/<SUB_TOKEN>)

# --- Учетные данные 3x-ui и AdGuard Home ---
PANEL_USER=""
PANEL_PASS=""
AGH_USER=""
AGH_PASS=""

# --- Xray / VLESS-Reality & CDN ---
REALITY_SNI="sun9-73.userapi.com" # По умолчанию берется из whitelist_sni.list
REALITY_PRIVATE_KEY=""
REALITY_PUBLIC_KEY=""
REALITY_SHORT_ID=""
MAIN_CLIENT_UUID=""
VK_CDN_DOMAIN=""                  # Домен, выданный VK Cloud CDN (опционально)
YA_CDN_DOMAIN=""                  # Домен, выданный Yandex Cloud CDN (опционально)

# --- AmneziaWG (AWG 2.0+ с обфускацией и CPS-сигнатурами) ---
AWG_SUBNET="10.8.1.0/24"
AWG_SERVER_IP="10.8.1.1"
AWG_INTERFACE="awg0"
AWG_JC="5"
AWG_JMIN="40"
AWG_JMAX="120"
# Параметры S1-S4 и H1-H4 генерируются автоматически для каждого сервера
AWG_S1=""
AWG_S2=""
AWG_S3=""
AWG_S4=""
AWG_H1=""
AWG_H2=""
AWG_H3=""
AWG_H4=""
# Цепочки CPS-сигнатур I1-I5 (имитация QUIC/TLS/DNS)
AWG_I1=""
AWG_I2=""
AWG_I3=""
AWG_I4=""
AWG_I5=""

# --- Telegram Proxy ---
MTPROTO_FAKE_SNI="yandex.ru"
MTPROTO_SECRET=""
SOCKS5_USER="tguser"
SOCKS5_PASS=""

# --- Сайт-заглушка и генератор сетевого шума ---
DECOY_NOISE_ENABLED="true"
SERVER_NOISE_DAEMON_ENABLED="false"

# --- Кластер Combain-Mesh (P2P 2-3 exit-ноды + 1 RU relay, подписки с лимитами) ---
MESH_ENABLED="0"
MESH_ROLE="exit"                  # Роль ноды: "exit" (зарубежный выход) или "ru_relay" (RU-ретранслятор)
MESH_NODE_NAME=""                 # Имя ноды в кластере (напр. de-1, nl-1, ru-msk-1)
MESH_WG_PORT="51829"              # UDP-порт приватной WireGuard-сети wg-mesh0
MESH_WG_SUBNET="10.99.0.0/24"     # Подсеть кластера Combain-Mesh
MESH_WG_IP="10.99.0.1"            # Внутренний IP этой ноды в wg-mesh0 (10.99.0.1, .2, .3...)
MESH_API_PORT="22777"             # Порт HTTP API Combain-Mesh (127.0.0.1 + wg-mesh0)
MESH_SECRET=""                    # Общий HMAC-секрет кластера (генерируется при инициализации)
